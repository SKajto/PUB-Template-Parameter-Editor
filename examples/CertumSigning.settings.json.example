{
  "_comment": [
    "Example of a filled-in CertumSigning.settings.json. Copy the shape, never the values: an invented",
    "thumbprint would make the repository claim a provenance that does not exist, and both the tests",
    "and the release job reject that. A thumbprint is public information; the access to the signing",
    "card is the secret, and it never appears in a file."
  ],
  "state": "Recorded",
  "ciSigning": false,
  "provider": "Certum SimplySign (Open Source Code Signing in the Cloud)",
  "signerCommonName": "Open Source Developer <the legal name the certificate authority records>",
  "certificateThumbprint": "0123456789ABCDEF0123456789ABCDEF01234567",
  "certificateNotAfter": "2027-10-29",
  "timestampUrl": "http://time.certum.pl",
  "fileDigestAlgorithm": "sha256",
  "timestampDigestAlgorithm": "sha256",
  "publicCertificatePath": "tools/signing/PUB-Template-Parameter-Editor-code-signing.cer",
  "notes": {
    "hashes": "take every published SHA-256 after signing",
    "renewal": "about a year per certificate, so later releases carry a different key; the timestamp keeps the older ones verifiable"
  }
}
