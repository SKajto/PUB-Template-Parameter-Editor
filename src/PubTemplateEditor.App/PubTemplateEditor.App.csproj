<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The executable and assembly carry the product name: the file a user downloads and
     sees in Task Manager is called the same thing as the application. Underscores rather
     than spaces keep it usable on the command line, in scripts and in package paths. -->
     <AssemblyName>PUB_Template_Parameter_Editor</AssemblyName>
    <RootNamespace>PubTemplateEditor.App</RootNamespace>
    <!-- Task Manager and the file properties dialog show the product, not the file stem. -->
    <AssemblyTitle>PUB Template Parameter Editor</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- File icon of the executable and of the window. The artwork is drawn by
         tools/brand/generate-brand-assets.ps1 in this repository; nothing third-party is embedded. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PubTemplateEditor.Core\PubTemplateEditor.Core.csproj" />
    <ProjectReference Include="..\PubTemplateEditor.Infrastructure\PubTemplateEditor.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and taskbar icon, resolved by pack URI from this assembly. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="..\..\LICENSE" Link="Assets\LICENSE.txt" />
    <Resource Include="..\..\NOTICE" Link="Assets\NOTICE.txt" />
    <Resource Include="..\..\THIRD-PARTY-NOTICES.txt" Link="Assets\THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

</Project>
