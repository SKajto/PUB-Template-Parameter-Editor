<Window x:Class="PubTemplateEditor.App.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/PUB_Template_Parameter_Editor;component/Assets/app.ico"
        Title="About, licence and bundled components"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontSize="{DynamicResource UiFontSize}">
    <DockPanel TextElement.Foreground="{DynamicResource ForegroundBrush}">
        <TextBlock x:Name="SourceLine" DockPanel.Dock="Bottom" Margin="10,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"/>
        <TabControl x:Name="NoticeTabs" BorderThickness="0" Background="{DynamicResource WindowBackgroundBrush}">
        <TabItem Header="About">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="AboutNameText" FontWeight="SemiBold" FontSize="18"/>
                    <TextBlock x:Name="AboutTaglineText" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="AboutDescriptionText" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="620" HorizontalAlignment="Left"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBlock x:Name="AboutVersionText" VerticalAlignment="Center"/>
                            <Button x:Name="CheckUpdateButton" Content="Check for a new version"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Click="CheckUpdate_Click" Margin="14,0,0,0" Padding="2,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Asks the release service for the newest published version number. Nothing is downloaded, and no request is made unless you click here."/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UpdateStatusText" Margin="0,2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   ToolTip="A release check is one anonymous request for a version number. The program makes no other request and uploads nothing."><Run x:Name="UpdateStatusRun"/><Hyperlink x:Name="ReleaseLink" RequestNavigate="OnLinkNavigate"><Run x:Name="ReleaseLinkText"/></Hyperlink></TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Licence" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutLicenseText" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Copyright" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AboutCopyrightText" Margin="0,2" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Operation" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AboutOperationText" Margin="0,2" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Runtime" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AboutRuntimeText" Margin="0,2" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Project" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,2">
                            <Hyperlink x:Name="RepositoryLink" RequestNavigate="OnLinkNavigate"><Run x:Name="RepositoryLinkText"/></Hyperlink>
                        </TextBlock>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Source of this version" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,2">
                            <Hyperlink x:Name="SourceLink" RequestNavigate="OnLinkNavigate"><Run x:Name="SourceLinkText"/></Hyperlink>
                        </TextBlock>
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Problems and questions" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,2">
                            <Hyperlink x:Name="IssuesLink" RequestNavigate="OnLinkNavigate"><Run x:Name="IssuesLinkText"/></Hyperlink>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Bundled components" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock x:Name="AboutBundledText" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="680" HorizontalAlignment="Left"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>

                    <TextBlock x:Name="AboutWarrantyText" TextWrapping="Wrap" Margin="0,16,0,0" MaxWidth="680" HorizontalAlignment="Left"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="GNU GPL v3">
            <TextBox x:Name="LicenseText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Courier New"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="10" />
        </TabItem>
        <TabItem Header="Notice">
            <TextBox x:Name="NoticeText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Courier New"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="10" />
        </TabItem>
        <TabItem Header="Third-party">
            <TextBox x:Name="ThirdPartyText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Courier New"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="10" />
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
