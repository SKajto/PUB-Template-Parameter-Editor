<Window x:Class="PubTemplateEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PubTemplateEditor.App.Infrastructure"
        Title="PUB Template Parameter Editor"
        Width="1240" Height="780" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        FontSize="{DynamicResource UiFontSize}">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenFolderCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReadParametersCommand}"/>
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding FocusFilterCommand}"/>
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding FocusParameterSearchCommand}"/>
        <KeyBinding Modifiers="Control" Key="L" Command="{Binding OpenLicensesCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding OpenReviewCommand}"/>
        <!-- Staging is the unit of work here, so the keys work on staged changes: Ctrl+Enter offers the
             fields of the open form, Ctrl+Z takes back the change staged last. Inside a value box Ctrl+Z
             stays with the text editor, which is where an accidental keystroke has to be undone. -->
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding ApplyEditsCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoLastStagedCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}"/>
    </Window.InputBindings>

    <!-- The theme text colour is inherited from here; see the note in Themes/Controls.xaml.
         A style setter would beat the colour controls pass down, so the implicit TextBlock
         style deliberately does not set Foreground. -->
    <Grid TextElement.Foreground="{DynamicResource ForegroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= top bar: identity, theme, folder ================= -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="PUB" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BrandTitleText" Text="{Binding ProductName}" FontWeight="SemiBold"/>
                    <TextBlock Text="Local template workspace" Style="{StaticResource FieldNoteStyle}" Margin="0"/>
                </StackPanel>

                <!-- Staged changes are session state, so the counter and the controls that manage it
                     (review entry, discard) sit in the top bar next to the folder they belong to.
                     The per-field rows stay in the details column. -->
                <StackPanel x:Name="StagedTray" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Style="{StaticResource BadgeBorderStyle}" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconLineStyle}" Data="{StaticResource IconListChecks}"
                                  Width="13" Height="13" Margin="0,0,5,0"
                                  Stroke="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock x:Name="StagedTrayText" Text="{Binding StagedSummary}" FontSize="12"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="TopReviewButton" Content="Review and save" Command="{Binding OpenReviewCommand}"
                            infra:Iconics.Icon="{StaticResource IconListChecks}"
                            Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0"
                            ToolTip="List every staged change before anything is written (Ctrl+S)"
                            AutomationProperties.Name="Review staged changes"/>
                    <Button x:Name="UndoStagedButton" Content="Undo last" Command="{Binding UndoLastStagedCommand}"
                            Margin="8,0,0,0" infra:Iconics.Icon="{StaticResource IconUndo}"
                            ToolTip="Take back the change staged last (Ctrl+Z); a save that already happened is not undone"
                            AutomationProperties.Name="Undo the last staged change"/>
                    <Button x:Name="DiscardAllButton" Content="Discard all" Command="{Binding DiscardAllStagedCommand}" Margin="8,0,0,0"
                            infra:Iconics.Icon="{StaticResource IconTrash}"
                            ToolTip="Forget the staged proposals and the unapplied typing of this session; no template file is written"
                            AutomationProperties.Name="Discard all staged changes"/>
                </StackPanel>

                <!-- Interface mode as icon buttons; each carries a text alternative for assistive
                     technology and a tooltip naming the mode. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <RadioButton GroupName="theme" Style="{StaticResource SegmentIconRadioStyle}"
                                 IsChecked="{Binding IsLightSelected, Mode=OneWay}"
                                 Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                 ToolTip="Light interface" AutomationProperties.Name="Light theme">
                        <Path Style="{StaticResource RadioIconStyle}" Data="{StaticResource IconSun}" Width="17" Height="17"/>
                    </RadioButton>
                    <RadioButton GroupName="theme" Style="{StaticResource SegmentIconRadioStyle}" Margin="-1,0,0,0"
                                 IsChecked="{Binding IsDarkSelected, Mode=OneWay}"
                                 Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                 ToolTip="Dark interface" AutomationProperties.Name="Dark theme">
                        <Path Style="{StaticResource RadioIconStyle}" Data="{StaticResource IconMoon}" Width="17" Height="17"/>
                    </RadioButton>
                    <RadioButton GroupName="theme" Style="{StaticResource SegmentIconRadioStyle}" Margin="-1,0,0,0"
                                 IsChecked="{Binding IsSystemSelected, Mode=OneWay}"
                                 Command="{Binding SetThemeCommand}" CommandParameter="System"
                                 ToolTip="Follow the Windows colour setting" AutomationProperties.Name="Follow Windows theme">
                        <Path Style="{StaticResource RadioIconStyle}" Data="{StaticResource IconMonitor}" Width="17" Height="17"/>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= workspace: explorer | parameters | details ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="340" MaxWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- template explorer -->
            <Border x:Name="TemplatesPanelBorder" Grid.Column="0" Style="{StaticResource PanelBorderStyle}" BorderThickness="0,1,1,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,10,10,0">
                        <TextBlock Text="TEMPLATES" Style="{StaticResource EyebrowStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FolderNameText" Grid.Column="0" Text="{Binding FolderName}"
                                       ToolTip="{Binding FolderPath}"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock x:Name="FileCountText" Text="{Binding TotalFileCount}"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,10">
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock x:Name="ScopeText" Text="{Binding ScopeDescription}" Style="{StaticResource FieldNoteStyle}"
                                   Margin="0,0,0,6"/>
                        <Button x:Name="ReadParametersButton" Content="Read parameters" Command="{Binding ReadParametersCommand}"
                                infra:Iconics.Icon="{StaticResource IconReload}"
                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                ToolTip="Parse declarations of the selected templates (F5)"/>
                    </StackPanel>

                    <!-- The folder is opened where its templates are listed, not in the window chrome:
                         the name of the folder and the control that changes it belong to the same panel,
                         and the folder name is shown only once. -->
                    <Button x:Name="ChooseFolderButton" Content="Choose folder" Command="{Binding OpenFolderCommand}"
                            DockPanel.Dock="Top" Margin="10,8,10,0" HorizontalAlignment="Stretch"
                            infra:Iconics.Icon="{StaticResource IconFolderOpen}"
                            ToolTip="Choose the folder containing .dta templates (Ctrl+O)"
                            AutomationProperties.Name="Choose the folder of template files"/>

                    <!-- A folder shortcut list, not a list of files: the workspace is scoped by folder, and
                         remembering paths is the only way to reopen a deep folder without browsing again. -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0"
                                Visibility="{Binding HasRecentFolders, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Recent folders" Style="{StaticResource EyebrowStyle}"/>
                        <ComboBox x:Name="RecentFoldersBox" ItemsSource="{Binding RecentFolders}" SelectedIndex="-1"
                                  ToolTip="Reopen a folder that was listed before"
                                  SelectionChanged="RecentFoldersBox_SelectionChanged"
                                  AutomationProperties.Name="Recent template folders"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0">
                        <TextBlock Text="Filter files" Style="{StaticResource EyebrowStyle}"/>
                        <Grid>
                            <TextBox x:Name="FilterBox"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                     AutomationProperties.Name="Filter files by name"/>
                            <TextBlock Text="Filename…" Style="{StaticResource PlaceholderStyle}"
                                       Visibility="{Binding FilterText, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Select visible" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding SelectVisibleCommand}"/>
                            <Button Content="Clear visible" Style="{StaticResource LinkButtonStyle}" Margin="10,0,0,0"
                                    Command="{Binding ClearVisibleCommand}"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectedCountText" Style="{StaticResource FieldNoteStyle}"
                                   Text="{Binding SelectedReadCount, StringFormat={}{0} selected for reading}"/>
                    </StackPanel>

                    <ListBox x:Name="TemplateList" Margin="6,8,6,4" Padding="0"
                             ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding ActiveFile}"
                             SelectionMode="Single" BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.Name="Template files; select the active template">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource TemplateRowStyle}">
                                <!-- The row tooltip is the file's summary: its name, how many parameters it
                                     holds and how many staged changes it carries. The cells show only a
                                     fragment, and the bare path would not be enough to choose a file by. -->
                                <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip Style="{StaticResource RowToolTipStyle}" Content="{Binding RowTooltip}"/>
                                </Setter.Value>
                            </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForRead}"
                                              IsEnabled="{Binding IsListable}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding FileName, StringFormat={}Select {0} for reading}"/>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,1,0,0">
                                            <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" Style="{StaticResource SplitterStyle}"/>

            <!-- parameter table -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Reading the list and acting on it are separate lines: search and the access filter
                         on the left, the parameter tools at the right end of the same line. The active
                         template keeps its own heading, because everything below belongs to it. -->
                    <Grid Grid.Row="0" Margin="12,10,12,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE TEMPLATE" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="ActiveTemplateText" Text="{Binding ActiveTemplateName}" Style="{StaticResource SectionTitleStyle}">
    <TextBlock.ToolTip>
        <ToolTip Style="{StaticResource RowToolTipStyle}" Content="{Binding ActiveFile.RowTooltip}"/>
    </TextBlock.ToolTip>
</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Parameter actions belong to the list they act on: the target is the parameter
                         highlighted in the table below. Compare and bulk apply share the line with the
                         search box and the access filter, at its right end. The review entry stays in the
                         top bar next to the staged-count badge, because it always covers the whole session
                         rather than the selected parameter. -->
                    <Grid x:Name="ParameterToolsRow" Grid.Row="1" Margin="12,10,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBox x:Name="ParameterSearchBox"
                                     Text="{Binding ParameterQuery, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                     IsEnabled="{Binding HasActiveFile}"
                                     AutomationProperties.Name="Search parameters by name or description"/>
                            <TextBlock Text="Search name or description…" Style="{StaticResource PlaceholderStyle}"
                                       Visibility="{Binding ParameterQuery, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>

                        <ComboBox x:Name="AccessFilterBox" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding AccessFilterLabels}"
                                  SelectedIndex="{Binding AccessFilterIndex}"
                                  IsEnabled="{Binding HasActiveFile}"
                                  ToolTip="Show only the parameters whose access is internal or external"
                                  AutomationProperties.Name="Filter by access"/>

                        <WrapPanel x:Name="ParameterActionsPanel" Grid.Column="2" Margin="10,0,0,0"
                                   HorizontalAlignment="Right">
                            <Button x:Name="CompareButton" Content="Compare" Margin="0,0,8,0"
                                    infra:Iconics.Icon="{StaticResource IconCompare}"
                                    Command="{Binding CompareCommand}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Show this parameter across every read template"
                                    AutomationProperties.Name="Compare this parameter with the other templates"/>
                            <Button x:Name="BulkButton" Content="Apply value to templates" Margin="0,0,0,0"
                                    infra:Iconics.Icon="{StaticResource IconBrush}"
                                    Command="{Binding OpenBulkCommand}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Stage one default value across several templates"
                                    AutomationProperties.Name="Apply one default value to many templates"/>
                        </WrapPanel>
                    </Grid>

                    <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="12,8,12,0" Style="{StaticResource FieldNoteStyle}"
                               Text="{Binding ActiveParameterSummary}"/>

                    <StackPanel Grid.Row="3" Margin="12,8,12,0">
                        <Border Style="{StaticResource ErrorNoticeStyle}"
                                Visibility="{Binding HasActionError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock x:Name="ActionErrorText" Text="{Binding ActionError}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorForegroundBrush}"/>
                        </Border>
                        <Border Style="{StaticResource SuccessNoticeStyle}"
                                Visibility="{Binding HasActionNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ActionNotice}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OkForegroundBrush}"/>
                                <Button Grid.Column="1" Content="×" Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding DismissNoticeCommand}"
                                        AutomationProperties.Name="Dismiss confirmation"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource WarningNoticeStyle}"
                                Visibility="{Binding ShowNoFileMatches, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="No template files match the folder filter."
                                       Foreground="{DynamicResource DirtyBrush}"/>
                        </Border>
                    </StackPanel>

                    <ListView Grid.Row="4" x:Name="ParameterList" Margin="12,10,12,12"
                              ItemsSource="{Binding VisibleParameters}"
                              SelectedItem="{Binding SelectedParameter}"
                              IsEnabled="{Binding HasActiveFile}"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <!-- Whole-parameter popup on the row: the columns truncate, and picking the
                                     right parameter should not require resizing every column first. -->
                                <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip Style="{StaticResource RowToolTipStyle}" Content="{Binding RowTooltip}"/>
                                </Setter.Value>
                            </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="260">
                                    <GridViewColumnHeader Content="Name"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource BadgeBorderStyle}"
                                                        Visibility="{Binding HasDrafts, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        ToolTip="{Binding DraftedFieldsSummary}">
                                                    <TextBlock Text="staged" FontSize="11" Style="{StaticResource DirtyBadgeStyle}"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeBorderStyle}"
                                                        Visibility="{Binding HasReadOnlyShape, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        ToolTip="{Binding ReadOnlyShapeReasons}">
                                                    <TextBlock Text="Read-only shape" FontSize="11"
                                                               Foreground="{DynamicResource DirtyBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="90" DisplayMemberBinding="{Binding AccessLabel}">
                                    <GridViewColumnHeader Content="Access"/>
                                </GridViewColumn>
                                <GridViewColumn Width="290" DisplayMemberBinding="{Binding DefaultPreview}">
                                    <GridViewColumnHeader Content="Default value"/>
                                </GridViewColumn>
                                <GridViewColumn Width="290" DisplayMemberBinding="{Binding DescriptionPreview}">
                                    <GridViewColumnHeader Content="Description"/>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- empty states over the table area; never intercept mouse input -->
                    <TextBlock Grid.Row="4" IsHitTestVisible="False" Margin="24" MaxWidth="460" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource FieldNoteStyle}"
                               Visibility="{Binding ShowEmptyNoActiveFile, Converter={StaticResource BoolToVisibilityConverter}}"
                               Text="Choose a template in the explorer. Focusing it does not add it to the read selection."/>
                    <TextBlock Grid.Row="4" IsHitTestVisible="False" Margin="24" MaxWidth="460" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource FieldNoteStyle}"
                               Visibility="{Binding ShowEmptyNotRead, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="Parameters not read yet."/><LineBreak/>
                        <Run Text="Select templates for reading or use the default visible-file scope, then press Read parameters."/>
                    </TextBlock>
                    <TextBlock Grid.Row="4" IsHitTestVisible="False" Margin="24" MaxWidth="460" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource FieldNoteStyle}"
                               Visibility="{Binding ShowEmptyNoMatches, Converter={StaticResource BoolToVisibilityConverter}}"
                               Text="No matching parameters."/>

                    <!-- ============ compare panel: the same parameter in every read template ============ -->
                                            <!-- ============ save review: the only place that could write ============
                             Every staged change of the session, per field, with a tick box each. The
                             primary action stays disabled until the write step exists, and says so
                             instead of pretending to save. -->
                        <Border Grid.Row="0" Grid.RowSpan="5" Margin="10" Panel.ZIndex="11"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="12,10,12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SAVE REVIEW" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock x:Name="ReviewSummaryText" Text="{Binding ReviewSummary}"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Select all" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0"
                                                Command="{Binding SelectAllReviewCommand}"
                                                AutomationProperties.Name="Select every staged change"/>
                                        <Button Content="Select none" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0"
                                                Command="{Binding SelectNoneReviewCommand}"
                                                AutomationProperties.Name="Deselect every staged change"/>
                                        <Button Content="Discard selected" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0"
                                                infra:Iconics.Icon="{StaticResource IconTrash}"
                                                Command="{Binding DiscardSelectedReviewCommand}"
                                                ToolTip="Forget the ticked proposals; no template file is written"
                                                AutomationProperties.Name="Discard the ticked staged changes"/>
                                        <Button Content="Close" Style="{StaticResource LinkButtonStyle}"
                                                infra:Iconics.Icon="{StaticResource IconClose}"
                                                Command="{Binding CloseReviewCommand}"
                                                AutomationProperties.Name="Close the save review"/>
                                    </StackPanel>
                                </Grid>

                                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="12,6,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Data="{StaticResource IconWarning}" Stroke="{DynamicResource DirtyBrush}"
                                                  Stretch="Uniform" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Visibility="{Binding CanSaveReview, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            <ProgressBar Width="96" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         IsIndeterminate="True" Value="0"
                                                         Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding SaveUnavailableReason}" TextWrapping="Wrap"
                                                       MaxWidth="420" VerticalAlignment="Center"
                                                       Style="{StaticResource FieldNoteStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SaveOutcomeSummary}" TextWrapping="Wrap"
                                                   Margin="24,4,0,0" Style="{StaticResource FieldNoteStyle}"
                                                   Visibility="{Binding HasSaveOutcome, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                        <Button x:Name="ReviewSaveButton" Grid.Column="1" Content="Save to templates" VerticalAlignment="Center"
                                                infra:Iconics.Icon="{StaticResource IconSave}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{Binding SaveReviewCommand}" IsEnabled="{Binding CanSaveReview}"
                                                ToolTip="{Binding SaveUnavailableReason}" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="Save the ticked changes to the templates"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,6"
                                              AutomationProperties.Name="Staged changes waiting for review">
                                    <!-- One card per staged change, grouped per template file. A GridView
                                     clipped long values, which made the review useless: the whole point is
                                     reading what the value says now and what it would say after the save.
                                     Values therefore get full-width wrapping text blocks, and the changed
                                     stretch is highlighted separately for long single-line descriptions. -->
                                    <ItemsControl x:Name="ReviewGroupsList" ItemsSource="{Binding ReviewGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,4"
                                                              ToolTip="{Binding FilePath}"
                                                              AutomationProperties.Name="Changes of one template">
                                                        <Path Style="{StaticResource IconLineStyle}" Data="{StaticResource IconListChecks}"
                                                              Width="14" Height="14" Margin="0,0,6,0"
                                                              Stroke="{DynamicResource MutedForegroundBrush}"/>
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                        <Border Style="{StaticResource BadgeBorderStyle}" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding ChangeCountText}" FontSize="11"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                                                VerticalAlignment="Top" Margin="0,3,10,0"
                                                                                AutomationProperties.Name="Include this change in the save"/>

                                                                        <StackPanel Grid.Column="1">
                                                                            <WrapPanel>
                                                                                <TextBlock Text="{Binding ParameterName}"
                                                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                                <Border Style="{StaticResource BadgeBorderStyle}" Margin="8,0,0,0">
                                                                                    <TextBlock Text="{Binding FieldLabel}" FontSize="11"
                                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                                </Border>
                                                                                <Border Style="{StaticResource BadgeBorderStyle}" Margin="6,0,0,0"
                                                                                        ToolTip="{Binding NoOpHint}">
                                                                                    <TextBlock Text="{Binding WriteStateText}" FontSize="11"
                                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                                </Border>
                                                                                <Border Style="{StaticResource BadgeBorderStyle}" Margin="6,0,0,0"
                                                                                        Visibility="{Binding HasHiddenWhitespace, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        ToolTip="{Binding HiddenWhitespaceHint}">
                                                                                    <TextBlock Text="spaces at the edge" FontSize="11"
                                                                                               Style="{StaticResource DirtyBadgeStyle}"/>
                                                                                </Border>
                                                                            </WrapPanel>

                                                                            <Grid Margin="0,8,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="124"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>

                                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="In the template"
                                                                                           Style="{StaticResource FieldNoteStyle}"/>
                                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BaselineText}"
                                                                                           TextWrapping="Wrap"
                                                                                           FontFamily="{DynamicResource MonoFontFamily}"/>

                                                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                                                                                           Text="After the save"
                                                                                           Style="{StaticResource FieldNoteStyle}"/>
                                                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                                                                           Text="{Binding ProposedText}" TextWrapping="Wrap"
                                                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                                            </Grid>

                                                                            <StackPanel Margin="0,8,0,0"
                                                                                      Visibility="{Binding HasValueDiff, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <TextBlock Text="The change in place"
                                                                                           Style="{StaticResource FieldNoteStyle}"/>
                                                                                <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="4"
                                                                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                                                                        Background="{DynamicResource WindowBackgroundBrush}"
                                                                                        Visibility="{Binding IsCompleteReplacement, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                                    <WrapPanel>
                                                                                        <TextBlock Text="{Binding Delta.PrefixShown}"
                                                                                                   FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap"
                                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                                   Visibility="{Binding Delta.PrefixShown, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>
                                                                                        <TextBlock Text="{Binding Delta.RemovedShown}"
                                                                                                   Margin="2,0" TextDecorations="Strikethrough"
                                                                                                   FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap"
                                                                                                   Foreground="{DynamicResource DirtyBrush}"
                                                                                                   Visibility="{Binding Delta.RemovedShown, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>
                                                                                        <TextBlock Text="{Binding Delta.AddedShown}"
                                                                                                   Margin="2,0" TextDecorations="Underline"
                                                                                                   FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap"
                                                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                                                   Visibility="{Binding Delta.AddedShown, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>
                                                                                        <TextBlock Text="{Binding Delta.SuffixShown}"
                                                                                                   FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap"
                                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                                   Visibility="{Binding Delta.SuffixShown, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>
                                                                                    </WrapPanel>
                                                                                </Border>
                                                                                <TextBlock Text="The whole value is replaced; none of the old text is kept."
                                                                                           Style="{StaticResource FieldNoteStyle}" Margin="0,4,0,0"
                                                                                           Visibility="{Binding IsCompleteReplacement, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                            </StackPanel>

                                                                            <TextBlock Text="{Binding NoOpHint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                                       Foreground="{DynamicResource DirtyBrush}"
                                                                                       Visibility="{Binding IsNoOp, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.RowSpan="5" Margin="10" Panel.ZIndex="10"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Visibility="{Binding IsCompareOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="12,10,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="COMPARE PARAMETER" Style="{StaticResource EyebrowStyle}"/>
                                    <TextBlock Text="{Binding DetailName}" Style="{StaticResource SectionTitleStyle}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Only selected templates"
                                          IsChecked="{Binding CompareSelectedOnly}"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Close" Style="{StaticResource LinkButtonStyle}"
                                        infra:Iconics.Icon="{StaticResource IconClose}"
                                        Command="{Binding CloseCompareCommand}"
                                        AutomationProperties.Name="Close compare panel"/>
                            </Grid>
                            <TextBlock x:Name="CompareSummaryText" DockPanel.Dock="Top" Margin="12,0,12,6"
                                       Style="{StaticResource FieldNoteStyle}" Text="{Binding CompareSummary}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,10">
                                <ItemsControl ItemsSource="{Binding CompareRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                   ToolTip="{Binding FilePath}"/>
                                                        <Border Style="{StaticResource BadgeBorderStyle}">
                                                            <TextBlock Text="{Binding StateLabel}" FontSize="11"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                                Visibility="{Binding HasUnsavedDrafts, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="staged values shown" FontSize="11"
                                                                       Style="{StaticResource DirtyBadgeStyle}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"
                                                               Style="{StaticResource FieldNoteStyle}"
                                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <ItemsControl ItemsSource="{Binding Fields}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding FieldLabel}"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveValue}"
                                                                               TextWrapping="Wrap" FontFamily="{DynamicResource MonoFontFamily}"/>
                                                                    <TextBlock Grid.Column="2" Text="→"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding TargetValue}"
                                                                               TextWrapping="Wrap" FontFamily="{DynamicResource MonoFontFamily}"
                                                                               Foreground="{DynamicResource DirtyBrush}"
                                                                               Visibility="{Binding IsDifferent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding TargetValue}"
                                                                               TextWrapping="Wrap" FontFamily="{DynamicResource MonoFontFamily}"
                                                                               Visibility="{Binding IsDifferent, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding StateLabel}"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ===== bulk panel: one default value, staged for many templates after review ===== -->
                    <Border Grid.Row="0" Grid.RowSpan="5" Margin="10" Panel.ZIndex="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Visibility="{Binding IsBulkOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                                <TextBlock Text="APPLY ONE VALUE TO TEMPLATES" Style="{StaticResource EyebrowStyle}"/>
                                <TextBlock Text="{Binding DetailName}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                                           Text="Bulk editing changes the default value only. Target access and description stay untouched."/>
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Margin="12,0,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="New default value" VerticalAlignment="Center"
                                           Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <TextBox x:Name="BulkValueBox" Grid.Column="1"
                                         Text="{Binding BulkValueDraft, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource MonoFontFamily}"
                                         AutomationProperties.Name="New default value for all selected templates"/>
                            </Grid>
                            <Grid DockPanel.Dock="Bottom" Margin="12,6,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BulkSummaryText" Grid.Column="0" Text="{Binding BulkSummary}"
                                           Style="{StaticResource FieldNoteStyle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource LinkButtonStyle}"
                                        infra:Iconics.Icon="{StaticResource IconClose}"
                                        Command="{Binding CloseBulkCommand}" Margin="0,0,8,0"
                                        AutomationProperties.Name="Cancel bulk value"/>
                                <Button x:Name="BulkConfirmButton" Grid.Column="2" Content="Apply value to selected templates"
                                        infra:Iconics.Icon="{StaticResource IconBrush}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding ConfirmBulkCommand}"
                                        AutomationProperties.Name="Stage this value in the selected templates"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
                                <ItemsControl ItemsSource="{Binding BulkTargets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                              IsEnabled="{Binding IsSelectable}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                                              AutomationProperties.Name="{Binding FileName}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                   ToolTip="{Binding FilePath}"/>
                                                        <TextBlock Text="{Binding CurrentValueText}"
                                                                   Style="{StaticResource FieldNoteStyle}"
                                                                   FontFamily="{DynamicResource MonoFontFamily}"/>
                                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"
                                                                   Style="{StaticResource FieldNoteStyle}"
                                                                   Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" Style="{StaticResource SplitterStyle}"/>

            <!-- parameter details -->
            <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}" BorderThickness="1,1,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="DETAILS" Style="{StaticResource EyebrowStyle}"/>

                        <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,10,0,10"
                                   Text="Select a row to inspect or edit its declaration fields."
                                   Visibility="{Binding HasSelectedParameter, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelectedParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Parameter name" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource BadgeBorderStyle}">
                                        <TextBlock Text="read-only" FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="DetailNameText" Text="{Binding DetailName}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"/>
                                <TextBlock Text="Renaming would break every reference to this parameter."
                                           Style="{StaticResource FieldNoteStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelectedParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Default value" FontWeight="SemiBold"/>
                                    <Border x:Name="DetailValueDraftBadge" Style="{StaticResource BadgeBorderStyle}"
                                            Visibility="{Binding DetailHasDefaultValueDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="staged" FontSize="11" Style="{StaticResource DirtyBadgeStyle}"/>
                                    </Border>
                                    <Border Style="{StaticResource BadgeBorderStyle}"
                                            Visibility="{Binding HasUnappliedFormEdits, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="unapplied" FontSize="11" Style="{StaticResource DirtyBadgeStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBox x:Name="DetailValueBox" Text="{Binding DetailDefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding CanEditDefaultValue, Converter={StaticResource InverseBooleanConverter}}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="140"
                                         Margin="0,4,0,0" FontFamily="{DynamicResource MonoFontFamily}"
                                         AutomationProperties.Name="Default value"/>
                                <TextBlock x:Name="DetailValueNoteText" Text="{Binding DetailDefaultValueNote}"
                                           TextWrapping="Wrap" Style="{StaticResource FieldNoteStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelectedParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Access" FontWeight="SemiBold"/>
                                    <Border x:Name="DetailAccessDraftBadge" Style="{StaticResource BadgeBorderStyle}"
                                            Visibility="{Binding DetailHasAccessDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="staged" FontSize="11" Style="{StaticResource DirtyBadgeStyle}"/>
                                    </Border>
                                </StackPanel>
                                <ComboBox x:Name="DetailAccessCombo" ItemsSource="{Binding AccessChoices}"
                                          SelectedItem="{Binding DetailAccess}"
                                          Visibility="{Binding CanEditAccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                          Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Access classification"/>
                                <TextBox x:Name="DetailAccessBox" Text="{Binding DetailAccess}" IsReadOnly="True"
                                         Visibility="{Binding CanEditAccess, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                         Margin="0,4,0,0" FontFamily="{DynamicResource MonoFontFamily}"
                                         AutomationProperties.Name="Access classification"/>
                                <TextBlock x:Name="DetailAccessNoteText" Text="{Binding DetailAccessNote}"
                                           TextWrapping="Wrap" Style="{StaticResource FieldNoteStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelectedParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Description" FontWeight="SemiBold"/>
                                    <Border x:Name="DetailDescriptionDraftBadge" Style="{StaticResource BadgeBorderStyle}"
                                            Visibility="{Binding DetailHasDescriptionDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="staged" FontSize="11" Style="{StaticResource DirtyBadgeStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBox x:Name="DetailDescriptionBox"
                                         Text="{Binding DetailDescription, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding CanEditDescription, Converter={StaticResource InverseBooleanConverter}}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="140"
                                         Margin="0,4,0,0" FontFamily="{DynamicResource MonoFontFamily}"
                                         AutomationProperties.Name="Description"/>
                                <TextBlock x:Name="DetailDescriptionNoteText" Text="{Binding DetailDescriptionNote}"
                                           TextWrapping="Wrap" Style="{StaticResource FieldNoteStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelectedParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="XML type property" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailXmlTypeText" Text="{Binding DetailXmlType}" Margin="0,4,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"/>
                                <TextBlock Text="Separate from Internal / External access; it is never edited here"
                                           Style="{StaticResource FieldNoteStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DetailActionsCard" Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelectedParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Staged changes of this parameter" FontWeight="SemiBold"/>
                                    <Border x:Name="DetailAnyDraftBadge" Style="{StaticResource BadgeBorderStyle}"
                                            Visibility="{Binding DetailHasAnyDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="unsaved" FontSize="11" Style="{StaticResource DirtyBadgeStyle}"/>
                                    </Border>
                                </StackPanel>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="ApplyEditsButton" Content="Apply edits" Margin="0,0,6,0"
                                            infra:Iconics.Icon="{StaticResource IconCheck}"
                                            Command="{Binding ApplyEditsCommand}"
                                            ToolTip="Stage the values typed in this form (Ctrl+Enter); nothing is written yet"
                                            AutomationProperties.Name="Stage the form changes for this parameter"/>
                                    <Button x:Name="RevertFormButton" Content="Undo unapplied typing" Margin="0,0,6,0"
                                            infra:Iconics.Icon="{StaticResource IconUndo}"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding RevertFormCommand}"
                                            AutomationProperties.Name="Reload the form with the session values"/>
                                    <Button x:Name="DiscardDraftsButton" Content="Discard staged for this parameter"
                                            infra:Iconics.Icon="{StaticResource IconTrash}"
                                            Style="{StaticResource LinkButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding DiscardDraftsForParameterCommand}"
                                            AutomationProperties.Name="Discard the staged changes of this parameter"/>
                                </WrapPanel>
                                <TextBlock x:Name="FormSummaryText" Text="{Binding FormSummary}" TextWrapping="Wrap"
                                           Style="{StaticResource FieldNoteStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource WarningNoticeStyle}"
                                Visibility="{Binding HasDetailReadOnlyReason, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Unsupported declaration shape" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DirtyBrush}"/>
                                <TextBlock Text="{Binding DetailReadOnlyReason}" TextWrapping="Wrap"
                                           Style="{StaticResource FieldNoteStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Review-gated saving" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                                           Text="Editing stages drafts in memory. Only Review Save writes; each file is fingerprint-checked, backed up, replaced and verified. Multi-file saving is not one global atomic operation."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= footer ================= -->
        <Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterCountText" Grid.Column="0" Text="{Binding FolderSummaryText}"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="FooterOperationText" Text="{Binding OperationText}"
                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="StagedBadge" Style="{StaticResource BadgeBorderStyle}"
                            Visibility="{Binding HasStagedChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="StagedSummaryText" Text="{Binding StagedSummary}" FontSize="11"
                                   Style="{StaticResource DirtyBadgeStyle}"/>
                    </Border>
                    <TextBlock Margin="8,0,0,0" Text="Review and save in the top bar"
                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"
                               FontSize="11"/>
                    <!-- The keys are listed where the work is reported, so they are found without a help page. -->
                    <TextBlock Margin="14,0,0,0" Text="Ctrl+Enter stage · Ctrl+Z undo staged · Ctrl+S review · Esc close panel"
                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"
                               FontSize="11"/>
                </StackPanel>
                <Button x:Name="VersionButton" Grid.Column="2" Content="{Binding VersionLabel}"
                        Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenLicensesCommand}"
                        ToolTip="About, licence and bundled-component notices (Ctrl+L)"
                        AutomationProperties.Name="About and licences"/>
            </Grid>
        </Border>

        <!-- Drag-and-drop affordance. The workspace is scoped by folder, so a dropped folder opens that
             folder and a dropped template opens the folder holding it. The panel only exists while a
             drag hovers the window, and never takes the mouse. -->
        <Border x:Name="DropHint" Grid.RowSpan="3" Panel.ZIndex="30" Margin="16" CornerRadius="8"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
            <TextBlock x:Name="DropHintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"/>
        </Border>
    </Grid>
</Window>
