<Window x:Class="PubTemplateEditor.App.UnsavedWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved work"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ShowInTaskbar="False">
    <!-- The prompt has to answer three questions at a glance: what is about to happen, which kinds of
         unsaved work exist, and what each button does with them. The state chips make an unavailable
         choice understandable instead of leaving a greyed-out button unexplained. -->
    <Grid Margin="18" TextElement.Foreground="{DynamicResource ForegroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="6" VerticalAlignment="Top"
                    Background="{DynamicResource AccentSoftBrush}">
                <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource AccentBrush}"
                      Style="{StaticResource IconLineStyle}" Width="19" Height="19"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,1,0,0">
                <TextBlock Grid.Row="0" x:Name="HeadlineText" Style="{StaticResource SectionTitleStyle}"
                           Text="Unapplied editor changes"/>
                <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" Margin="0,6,0,0"
                           Style="{StaticResource FieldNoteStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Style="{StaticResource IconLineStyle}" Data="{StaticResource IconUndo}"
                          Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock x:Name="TypingStateText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               AutomationProperties.Name="Unapplied typing in the form"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Path Style="{StaticResource IconLineStyle}" Data="{StaticResource IconListChecks}"
                          Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock x:Name="StagedStateText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               AutomationProperties.Name="Staged changes of this session"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="ApplyButton" Content="Apply the form changes and continue"
                    Style="{StaticResource AccentButtonStyle}" Height="30"
                    HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    AutomationProperties.Name="Apply the editor form changes and continue"/>
            <Button x:Name="DiscardFormButton" Content="Discard the unapplied form changes and continue"
                    HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    AutomationProperties.Name="Discard unapplied form changes and continue"/>
            <Button x:Name="DiscardAllButton" Content="Discard form changes and every staged change, then continue"
                    HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    AutomationProperties.Name="Discard form changes and all staged changes and continue"/>
            <TextBlock x:Name="ApplyHelpText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
        </StackPanel>

        <Button Grid.Row="3" x:Name="KeepEditingButton" Content="Keep editing (nothing changes)"
                HorizontalAlignment="Stretch" Margin="0,10,0,0" Height="30"
                IsCancel="True"
                AutomationProperties.Name="Cancel the navigation and keep editing"/>
    </Grid>
</Window>
