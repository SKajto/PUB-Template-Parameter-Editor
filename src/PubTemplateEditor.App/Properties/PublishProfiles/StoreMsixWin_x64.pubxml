<?xml version="1.0" encoding="utf-8"?>
<!--
  Store MSIX payload profile: self-contained win-x64 in a normal file layout.
  Single-file staging is deliberately NOT used here (docs/GITHUB_STORE_RELEASE.md point 7);
  the portable EXE profile is the only single-file channel.
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
