<?xml version="1.0" encoding="utf-8"?>
<!--
  Development / optional portable distribution profile.
  Produces a single self-contained PUB_Template_Parameter_Editor.exe for win-x64.
  See docs/WINDOWS_PUBLISH.md. The MSIX payload is built separately (see
  packaging/). Nothing here is published through an app store, and no binary is
  code-signed: docs/RELEASE_PACKAGING.md.
-->
<Project>
  <PropertyGroup>
    <!-- TargetFramework comes from the project (net10.0-windows). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <DebugType>embedded</DebugType>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
