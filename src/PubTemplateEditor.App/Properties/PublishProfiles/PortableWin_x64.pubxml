<?xml version="1.0" encoding="utf-8"?>
<!--
  Development / optional portable distribution profile.
  Produces a single self-contained PubTemplateEditor.exe for win-x64.
  See docs/WINDOWS_PUBLISH.md. The Store MSIX payload is built separately
  (see packaging/). Neither is a Store-signed package; see docs/GPL_RELEASE.md.
-->
<Project>
  <PropertyGroup>
    <!-- TargetFramework comes from the project (net10.0-windows). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <DebugType>embedded</DebugType>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
