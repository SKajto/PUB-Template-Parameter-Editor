<Project>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Embedded debug symbols: a published payload carries no separate .pdb files. -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- The copyright holder of the application, as it reaches the payload's file
         metadata and the About view. Nothing else personal is recorded here. -->
    <Company>Suad Kajtazovic</Company>
    <Product>PUB Template Parameter Editor</Product>
    <Copyright>Copyright (C) 2026 Suad Kajtazovic</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <!-- The owner's public repository: the corresponding source of every release lives here. -->
    <RepositoryUrl>https://github.com/SKajto/PUB-Template-Parameter-Editor</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
