<Project>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Embedded debug symbols: a published payload carries no separate .pdb files. -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Company>PUB Template Parameter Editor contributors</Company>
    <Product>PUB Template Parameter Editor</Product>
    <Copyright>Copyright (C) PUB Template Parameter Editor contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <!-- GitHub remote URL is supplied by the owner; leave unset until it is real. -->
  </PropertyGroup>
</Project>
